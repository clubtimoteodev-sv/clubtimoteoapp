generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("admin")
  createdAt DateTime @default(now())
}

model Explorer {
  id                  String   @id @default(cuid())
  codigoExplorador    String   @unique
  nombre              String
  apellidos           String
  fechaNacimiento     DateTime
  direccion           String
  telefono            String

  alergias            String?
  medicinaControlada  String?
  estudia             Boolean
  nivelEducativo      String?

  nombreResponsable   String
  telefonoResponsable String

  aceptoCristo        Boolean
  bautizado           Boolean
  asisteCelula        Boolean
  nombreLiderCelula   String?

  fotoUrl             String?
  recetaUrl           String?
  permisoUrl          String?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  attendanceRecords   AttendanceRecord[]
  serviceMembers      ServiceGroupMember[]
  serviceAttendanceMembers ServiceAttendanceMember[]
}

model Meeting {
  id        String   @id @default(cuid())
  date      DateTime
  type      String
  createdAt DateTime @default(now())
  records   AttendanceRecord[]
}

model AttendanceRecord {
  id            String   @id @default(cuid())
  meetingId     String
  explorerId    String
  attended      Boolean
  justification String?

  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  explorer  Explorer @relation(fields: [explorerId], references: [id], onDelete: Cascade)

  @@unique([meetingId, explorerId])
  @@index([explorerId])
}

model FinanceMovement {
  id          String   @id @default(cuid())
  type        String
  amount      Decimal  @db.Decimal(12,2)
  category    String
  description String
  date        DateTime
  recipient   String
  receiptUrl  String?
  createdAt   DateTime @default(now())
}

model ServiceGroup {
  id        String   @id @default(cuid())
  date      DateTime
  day       String
  createdAt DateTime @default(now())

  members     ServiceGroupMember[]
  attendances ServiceAttendance[]
}

model ServiceGroupMember {
  id         String @id @default(cuid())
  groupId    String
  explorerId String

  group    ServiceGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  explorer Explorer     @relation(fields: [explorerId], references: [id], onDelete: Cascade)

  @@unique([groupId, explorerId])
}

model ServiceAttendance {
  id           String   @id @default(cuid())
  groupId      String
  takenAt      DateTime @default(now())
  serviceNotes String?

  group    ServiceGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  members  ServiceAttendanceMember[]
}

model ServiceAttendanceMember {
  id            String  @id @default(cuid())
  attendanceId  String
  explorerId    String
  present       Boolean
  note          String?

  attendance ServiceAttendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  explorer   Explorer          @relation(fields: [explorerId], references: [id], onDelete: Cascade)

  @@unique([attendanceId, explorerId])
}
