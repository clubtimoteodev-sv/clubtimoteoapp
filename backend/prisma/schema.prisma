generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Destacamento {
  id                String   @id @default(cuid())
  codigo            String   @unique
  nombre            String
  iglesia           String?
  direccion         String?
  ciudad            String?
  telefono          String?
  encargado         String?
  createdAt         DateTime @default(now())

  users             User[]
  explorers         Explorer[]
  meetings          Meeting[]
  financeMovements  FinanceMovement[]
  serviceGroups     ServiceGroup[]
}

model User {
  id               String        @id @default(cuid())
  name             String
  email            String        @unique
  password         String
  role             String        @default("admin")
  destacamentoId   String
  createdAt        DateTime      @default(now())

  destacamento     Destacamento  @relation(fields: [destacamentoId], references: [id], onDelete: Cascade)

  @@index([destacamentoId])
}

model Explorer {
  id                       String   @id @default(cuid())
  codigoInterno            String
  nombre                   String
  apellidos                String
  fechaNacimiento          DateTime
  direccion                String
  telefono                 String

  alergias                 String?
  medicinaControlada       String?
  estudia                  Boolean
  nivelEducativo           String?

  nombreResponsable        String
  telefonoResponsable      String

  aceptoCristo             Boolean
  bautizado                Boolean
  asisteCelula             Boolean
  nombreLiderCelula        String?

  fotoUrl                  String?
  recetaUrl                String?
  permisoUrl               String?

  destacamentoId           String
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  destacamento             Destacamento @relation(fields: [destacamentoId], references: [id], onDelete: Cascade)
  attendanceRecords        AttendanceRecord[]
  serviceMembers           ServiceGroupMember[]
  serviceAttendanceMembers ServiceAttendanceMember[]

  @@unique([destacamentoId, codigoInterno])
  @@index([destacamentoId])
}

model Meeting {
  id               String        @id @default(cuid())
  date             DateTime
  type             String
  destacamentoId   String
  createdAt        DateTime      @default(now())

  destacamento     Destacamento  @relation(fields: [destacamentoId], references: [id], onDelete: Cascade)
  records          AttendanceRecord[]

  @@index([destacamentoId])
}

model AttendanceRecord {
  id             String   @id @default(cuid())
  meetingId      String
  explorerId     String
  attended       Boolean
  justification  String?

  meeting        Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  explorer       Explorer @relation(fields: [explorerId], references: [id], onDelete: Cascade)

  @@unique([meetingId, explorerId])
  @@index([explorerId])
  @@index([meetingId])
}

model FinanceMovement {
  id               String   @id @default(cuid())
  type             String
  amount           Decimal  @db.Decimal(12,2)
  category         String
  description      String
  date             DateTime
  recipient        String
  receiptUrl       String?
  destacamentoId   String
  createdAt        DateTime @default(now())

  destacamento     Destacamento @relation(fields: [destacamentoId], references: [id], onDelete: Cascade)

  @@index([destacamentoId])
}

model ServiceGroup {
  id               String   @id @default(cuid())
  date             DateTime
  day              String
  destacamentoId   String
  createdAt        DateTime @default(now())

  destacamento     Destacamento @relation(fields: [destacamentoId], references: [id], onDelete: Cascade)
  members          ServiceGroupMember[]
  attendances      ServiceAttendance[]

  @@index([destacamentoId])
}

model ServiceGroupMember {
  id         String @id @default(cuid())
  groupId    String
  explorerId String

  group      ServiceGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  explorer   Explorer     @relation(fields: [explorerId], references: [id], onDelete: Cascade)

  @@unique([groupId, explorerId])
  @@index([explorerId])
}

model ServiceAttendance {
  id           String   @id @default(cuid())
  groupId       String
  takenAt       DateTime @default(now())
  serviceNotes  String?

  group         ServiceGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  members       ServiceAttendanceMember[]

  @@index([groupId])
}

model ServiceAttendanceMember {
  id            String  @id @default(cuid())
  attendanceId  String
  explorerId    String
  present       Boolean
  note          String?

  attendance    ServiceAttendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  explorer      Explorer          @relation(fields: [explorerId], references: [id], onDelete: Cascade)

  @@unique([attendanceId, explorerId])
  @@index([explorerId])
}