generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------
// NUEVO: Modelo de Territorio (Ej. Occidente, Centro, Oriente)
// ------------------------------------------------------
model Territorio {
  id            String         @id @default(cuid())
  nombre        String         @unique
  descripcion   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  destacamentos Destacamento[] // Las iglesias que pertenecen a esta zona
  lideres       User[]         // Los líderes territoriales asignados aquí
}

model Destacamento {
  id               String            @id @default(cuid())
  codigo           String            @unique
  nombre           String
  iglesia          String?
  direccion        String?
  ciudad           String?
  telefono         String?
  encargado        String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  // NUEVO: Conexión con el Territorio
  territorioId     String?
  territorio       Territorio?       @relation(fields: [territorioId], references: [id])

  users            User[]
  explorers        Explorer[]
  meetings         Meeting[]
  financeMovements FinanceMovement[]
  serviceGroups    ServiceGroup[]

  @@index([territorioId])
}

model User {
  id             String        @id @default(cuid())
  name           String
  email          String        @unique
  password       String
  role           String        @default("admin")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  failedLoginAttempts Int      @default(0)
  isLocked            Boolean  @default(false)
  mustChangePassword  Boolean  @default(false)

  // MODIFICADO: Ahora es opcional (String?) porque un Líder Territorial 
  // podría no pertenecer a un destacamento específico, sino a un territorio entero.
  destacamentoId String?
  destacamento   Destacamento? @relation(fields: [destacamentoId], references: [id], onDelete: Cascade)

  // NUEVO: Conexión para el Líder Territorial
  territorioId   String?
  territorio     Territorio?   @relation(fields: [territorioId], references: [id])

  // PANEL ADMIN
  auditLogs      AuditLog[]
  backupLogs     BackupLog[]

  @@index([destacamentoId])
  @@index([territorioId])
}

model Explorer {
  id                       String                    @id @default(cuid())
  codigoInterno            String
  nombre                   String
  apellidos                String
  fechaNacimiento          DateTime
  direccion                String
  telefono                 String

  alergias                 String?
  medicinaControlada       String?
  estudia                  Boolean
  nivelEducativo           String?

  nombreResponsable        String
  telefonoResponsable      String

  aceptoCristo             Boolean
  bautizado                Boolean
  asisteCelula             Boolean
  nombreLiderCelula        String?

  fotoUrl                  String?
  recetaUrl                String?
  permisoUrl               String?

  destacamentoId           String
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  destacamento             Destacamento              @relation(fields: [destacamentoId], references: [id], onDelete: Cascade)
  attendanceRecords        AttendanceRecord[]
  serviceMembers           ServiceGroupMember[]
  serviceAttendanceMembers ServiceAttendanceMember[]

  @@unique([destacamentoId, codigoInterno])
  @@index([destacamentoId])
}

model Meeting {
  id             String               @id @default(cuid())
  date           DateTime
  type           String
  destacamentoId String
  createdAt      DateTime             @default(now())

  destacamento   Destacamento         @relation(fields: [destacamentoId], references: [id], onDelete: Cascade)
  records        AttendanceRecord[]

  @@index([destacamentoId])
}

model MeetingDeletionLog {
  id               String       @id @default(cuid())
  meetingId        String       // ID original (ya no existe en Meeting)
  meetingType      String       // Tipo de reunión borrada
  meetingDate      DateTime     // Fecha de la reunión borrada
  destacamentoId   String       // Destacamento al que pertenecía
  destacamentoName String       // Nombre del destacamento (copia denormalizada)
  territorioId     String?      // Territorio (para que el lider territorial lo vea)
  deletedById      String       // ID del usuario que eliminó
  deletedByName    String       // Nombre (copia denormalizada)
  justification    String       // Motivo obligatorio
  deletedAt        DateTime     @default(now())

  @@index([destacamentoId])
  @@index([territorioId])
  @@index([deletedAt])
}

model AttendanceRecord {
  id            String   @id @default(cuid())
  meetingId     String
  explorerId    String
  attended      Boolean
  justification String?

  meeting       Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  explorer      Explorer @relation(fields: [explorerId], references: [id], onDelete: Cascade)

  @@unique([meetingId, explorerId])
  @@index([explorerId])
  @@index([meetingId])
}

model FinanceMovement {
  id             String       @id @default(cuid())
  type           String
  amount         Decimal      @db.Decimal(12,2)
  category       String
  description    String
  date           DateTime
  recipient      String
  receiptUrl     String?
  destacamentoId String
  createdAt      DateTime     @default(now())

  destacamento   Destacamento @relation(fields: [destacamentoId], references: [id], onDelete: Cascade)

  @@index([destacamentoId])
}

model ServiceGroup {
  id             String              @id @default(cuid())
  date           DateTime
  day            String
  destacamentoId String
  createdAt      DateTime            @default(now())

  destacamento   Destacamento        @relation(fields: [destacamentoId], references: [id], onDelete: Cascade)
  members        ServiceGroupMember[]
  attendances    ServiceAttendance[]

  @@index([destacamentoId])
}

model ServiceGroupMember {
  id         String       @id @default(cuid())
  groupId    String
  explorerId String

  group      ServiceGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  explorer   Explorer     @relation(fields: [explorerId], references: [id], onDelete: Cascade)

  @@unique([groupId, explorerId])
  @@index([explorerId])
}

model ServiceAttendance {
  id           String                    @id @default(cuid())
  groupId      String
  takenAt      DateTime                  @default(now())
  serviceNotes String?

  group        ServiceGroup              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  members      ServiceAttendanceMember[]

  @@index([groupId])
}

model ServiceAttendanceMember {
  id           String            @id @default(cuid())
  attendanceId String
  explorerId   String
  present      Boolean
  note         String?

  attendance   ServiceAttendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  explorer     Explorer          @relation(fields: [explorerId], references: [id], onDelete: Cascade)

  @@unique([attendanceId, explorerId])
  @@index([explorerId])
}

// ──────────────────────────────────────────────
// PANEL ADMIN
// ──────────────────────────────────────────────

/// Registro de todas las operaciones de escritura exitosas
model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  endpoint  String
  method    String
  payload   String?  // JSON string del body
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([method])
}

/// Notificaciones para el administrador (ej: cuenta bloqueada)
model AdminNotification {
  id        String   @id @default(cuid())
  type      String   // "ACCOUNT_LOCKED", "SUSPICIOUS_ACTIVITY", etc.
  title     String
  message   String
  metadata  Json?    // datos adicionales (userId, email, etc.)
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read])
  @@index([createdAt])
}

/// Historial de backups SQL generados
model BackupLog {
  id             String   @id @default(cuid())
  filename       String
  generatedById  String
  createdAt      DateTime @default(now())

  generatedBy    User     @relation(fields: [generatedById], references: [id], onDelete: Cascade)

  @@index([generatedById])
  @@index([createdAt])
}