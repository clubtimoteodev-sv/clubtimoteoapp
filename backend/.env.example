# ─── Base de datos ──────────────────────────────────────────────
# Producción: usa tu URL de Supabase / Neon / Railway Postgres
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# ─── Autenticación ──────────────────────────────────────────────
# Genera uno seguro: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="CAMBIA_ESTO_POR_UN_SECRETO_SEGURO_DE_64_BYTES"

# ─── Servidor ───────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── Uploads ────────────────────────────────────────────────────
# Carpeta local para desarrollo. En producción usar Cloudinary/S3.
UPLOAD_DIR="uploads"

# ─── CORS adicional (opcional) ──────────────────────────────────
# Agrega orígenes extra separados por coma si los necesitas en staging
# EXTRA_CORS_ORIGINS=https://staging.tudominio.com,https://preview.tudominio.com
